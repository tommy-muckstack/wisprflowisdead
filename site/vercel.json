{
  "outputDirectory": ".",
  "git": {
    "deploymentEnabled": { "qa/parity-evidence-*": false }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/wisprflowisdead/api/:fn", "destination": "/api/:fn" },
    { "source": "/", "destination": "/wisprflowisdead" }
  ],
  "headers": [
    { "source": "/wisprflowisdead/assets/fonts/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
